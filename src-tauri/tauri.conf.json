{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SailHighSea VM",
  "version": "0.0.1-dev1",
  "identifier": "com.sailhighsea.vm",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "decorations": false,
        "url": "index.html",
        "title": "SailHighSea VM",
        "width": 920,
        "height": 640,
        "minWidth": 680,
        "minHeight": 420
      },
      {
        "label": "popup",
        "url": "tray.html",
        "title": "Volume Mixer",
        "width": 360,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Voice meter / volume mixer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
